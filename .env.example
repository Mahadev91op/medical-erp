# MongoDB Connection String
MONGODB_URI="mongodb://127.0.0.1:27017/medical-erp"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Super Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin_password"

# Local Backup Configuration (Optional)
BACKUP_DIR="D:\MedicalBackup"
MONGODUMP_PATH="C:\Program Files\MongoDB\Tools\100\bin\mongodump.exe"

# SMTP Email Configuration (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="PharmaERP <your_email@gmail.com>"

# Google Gemini AI API Key (Optional for AI OCR)
GEMINI_API_KEY="your_gemini_api_key_here"
